{
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "packages": {
    "studio": {
      "path": "studio",
      "component": "studio",
      "release-type": "node",
      "extra-files": [
        {
          "type": "generic",
          "path": "charts/studio/Chart.yaml",
          "glob": true
        }
      ]
    },
    ".": {
      "path": ".",
      "component": "backend",
      "release-type": "python",
      "extra-files": [
        {
          "type": "generic",
          "path": "charts/backend/Chart.yaml",
          "glob": true
        }
      ]
    }
  }
}
