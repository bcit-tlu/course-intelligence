# Copy this file to .env and fill in your values
# cp .env.example .env

# --- LLM Provider ---
# Options: "ollama", "lmstudio", "openai", "azure", "litellm", "mock"
# Switch providers by changing this one var + filling in the section below.
LLM_PROVIDER=ollama

# --- Ollama (local or cloud) ---
# Local:  OLLAMA_BASE_URL=http://localhost:11434  (no API key needed)
# Cloud:  OLLAMA_BASE_URL=https://ollama.com      (API key required)
OLLAMA_API_KEY=your_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# --- LM Studio (local only) ---
# Download from https://lmstudio.ai, load a model, start the local server.
# No API key needed. The model name is shown in LM Studio's server tab.
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL=local-model
# Reasoning effort: "none" (Gemma 4), "low"/"medium"/"high"/"xhigh" (Muse Glimmer),
# or leave empty to omit the parameter entirely
# LMSTUDIO_REASONING_EFFORT=none

# --- OpenAI (cloud) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=  # leave empty for api.openai.com, or set for proxies

# --- Azure OpenAI (pilot/prod) ---
# Uncomment and fill in when using Azure:
# AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=your-chat-deployment

# --- LiteLLM (self-hosted gateway) ---
# Uncomment and fill in when using LiteLLM as the provider:
# LITELLM_API_BASE=http://litellm:4000
# LITELLM_API_KEY=your_litellm_key_here
# LITELLM_MODEL=default-fast

# --- LLM gateway ---
# LLM_GATEWAY_URL is set automatically by docker-compose.yml (http://llm-gateway:8100)
# and by the Helm chart in production. Only set this here if you need to override.
# LLM_GATEWAY_URL=http://llm-gateway:8100

# --- LLM output limits ---
# Max output tokens per LLM call. Prevents truncated JSON responses.
# Increase if chunker output is being cut off on large pages.
LLM_MAX_TOKENS=8192

# Per-request HTTP timeout for LLM calls (seconds). Ensures a hung LLM
# server returns control to Python so signal.alarm can fire.
# Must be < JOB_TIMEOUT_S / max_retries (3) to stay within budget.
# Default: 180 (3 retries × 180s + 14s backoff = 554s < 600s job timeout)
LLM_REQUEST_TIMEOUT_S=180

# --- Testing ---
# Set to true to test the pipeline without LLM calls
MOCK_LLM=false

# --- Local development ---
# Enable uvicorn auto-reload for the API and gateway. Dev only —
# leave false (or unset) in production/containers.
DEV_RELOAD=false

# --- Upload retention ---
# Number of recent job uploads to retain in S3 (older uploads are purged)
RETENTION_COUNT=10

# --- Job timeout & watchdog ---
# Max seconds a single job may run before being killed (default: 600 = 10 min)
JOB_TIMEOUT_S=600
# How often (seconds) the watchdog checks for stale jobs (default: 60)
WATCHDOG_INTERVAL_S=60
# How long (seconds) a job can stay "processing" with no progress before
# being marked failed. Must be > JOB_TIMEOUT_S and should exceed the longest
# expected single pipeline step (default: 900 = 15 min)
WATCHDOG_STALE_THRESHOLD_S=900
